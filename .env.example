# ====================================================
# GetTwin Meet - MiroTalk P2P Configuration
# ====================================================

# App environment
NODE_ENV=production

# Signaling Server
HOST='https://meet.gettwin.io'
PORT=3009

# Trust Proxy (behind Nginx)
TRUST_PROXY=true

# Time Zone
TZ=Europe/Istanbul

# Logs
LOGS_DEBUG=false
LOGS_COLORS=true
LOGS_JSON=false
LOGS_JSON_PRETTY=false

# CORS - Allow embedding from app.gettwin.io and pos.gettwin.io
CORS_ORIGIN='["https://app.gettwin.io", "https://pos.gettwin.io", "https://meet.gettwin.io"]'
CORS_METHODS='["GET", "POST"]'

# IP whitelist (disabled - auth handled by host protection)
IP_WHITELIST_ENABLED=false

# OIDC (disabled - using Laravel Sanctum auth via API)
OIDC_ENABLED=false

# Active rooms (hide from public)
SHOW_ACTIVE_ROOMS=false

# Max participants per room (P2P realistic limit ~6)
ROOM_MAX_PARTICIPANTS=10

# Host protection
# HOST_PROTECTED=true requires valid credentials to create rooms
# HOST_USER_AUTH=true requires valid credentials to join rooms
# Laravel backend will mint JWT tokens for authenticated users
HOST_PROTECTED=true
HOST_USER_AUTH=true
HOST_USERS='[{"username": "gettwin_host", "password": "YOUR_HOST_PASSWORD"}, {"username": "gettwin_guest", "password": "YOUR_GUEST_PASSWORD"}]'

HOST_MAX_LOGIN_ATTEMPTS=5
HOST_MIN_LOGIN_BLOCK_TIME=15

# JWT token config (Laravel backend uses this to mint tokens)
JWT_KEY=YOUR_RANDOM_64_CHAR_SECRET
JWT_EXP=1h

# Presenters
PRESENTERS='["GetTwin Host"]'

# Ngrok (disabled)
NGROK_ENABLED=false

# STUN Server
STUN_SERVER_ENABLED=true
STUN_SERVER_URL=stun:stun.l.google.com:19302

# TURN Server (using free metered.ca relay - replace with your own for production)
TURN_SERVER_ENABLED=true
TURN_SERVER_URL=turn:a.relay.metered.ca:443
TURN_SERVER_USERNAME=e8dd65b92c62d3e36cafb807
TURN_SERVER_CREDENTIAL=uWdWNmkhvyqTEswO

# IP lookup (disabled for privacy)
IP_LOOKUP_ENABLED=false

# API - Laravel backend calls this to create meetings and mint tokens
API_KEY_SECRET=YOUR_RANDOM_API_SECRET
API_DISABLED='[]'

# Custom Noise Suppression
CUSTOM_NOISE_SUPPRESSION_ENABLED=true

# Survey (disabled - redirect to CRM instead)
SURVEY_ENABLED=false
SURVEY_URL=https://app.gettwin.io

# Redirect on leave room - send back to CRM meets page
REDIRECT_ENABLED=true
REDIRECT_URL='https://app.gettwin.io/platform/meets'

# Sentry (disabled)
SENTRY_ENABLED=false

# Slack (disabled)
SLACK_ENABLED=false

# Mattermost (disabled)
MATTERMOST_ENABLED=false

# ChatGPT (disabled)
CHATGPT_ENABLED=false

# Email alerts (disabled)
EMAIL_ALERT=false

# Stats (disabled - no tracking to MiroTalk)
STATS_ENABLED=false

# Webhook - notify Laravel backend of meeting events
WEBHOOK_URL=https://app.gettwin.io/api/webhook/mirotalk
