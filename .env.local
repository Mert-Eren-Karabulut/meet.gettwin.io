# ====================================================
# GetTwin Meet - LOCAL DEV Configuration
# ====================================================
# Copy this to .env for local development

# App environment
NODE_ENV=development

# Signaling Server
HOST='http://localhost:3009'
PORT=3009

# Trust Proxy (no proxy locally)
TRUST_PROXY=false

# Time Zone
TZ=Europe/Istanbul

# Logs
LOGS_DEBUG=true
LOGS_COLORS=true
LOGS_JSON=false
LOGS_JSON_PRETTY=false

# CORS - Allow Herd .test domain and localhost
CORS_ORIGIN='["https://app.gettwin.io.test", "http://localhost:3000", "http://localhost:3009"]'
CORS_METHODS='["GET", "POST"]'

# IP whitelist (disabled)
IP_WHITELIST_ENABLED=false

# OIDC (disabled)
OIDC_ENABLED=false

# Active rooms (show for debugging)
SHOW_ACTIVE_ROOMS=true

# Max participants per room
ROOM_MAX_PARTICIPANTS=10

# Host protection (same as prod)
HOST_PROTECTED=true
HOST_USER_AUTH=true
HOST_USERS='[{"username": "gettwin_host", "password": "dev_host_secret"}, {"username": "gettwin_guest", "password": "dev_guest_secret"}]'

HOST_MAX_LOGIN_ATTEMPTS=5
HOST_MIN_LOGIN_BLOCK_TIME=15

# JWT token config (use simple dev secret - must match Laravel .env MIROTALK_JWT_KEY)
JWT_KEY=mirotalk_dev_jwt_secret_key_2024
JWT_EXP=1h

# Presenters
PRESENTERS='["GetTwin Host"]'

# Ngrok (disabled)
NGROK_ENABLED=false

# STUN Server
STUN_SERVER_ENABLED=true
STUN_SERVER_URL=stun:stun.l.google.com:19302

# TURN Server
TURN_SERVER_ENABLED=true
TURN_SERVER_URL=turn:a.relay.metered.ca:443
TURN_SERVER_USERNAME=e8dd65b92c62d3e36cafb807
TURN_SERVER_CREDENTIAL=uWdWNmkhvyqTEswO

# IP lookup (disabled)
IP_LOOKUP_ENABLED=false

# API - Laravel calls this
API_KEY_SECRET=mirotalk_dev_api_secret
API_DISABLED='[]'

# Noise Suppression
CUSTOM_NOISE_SUPPRESSION_ENABLED=true

# Survey (disabled)
SURVEY_ENABLED=false

# Redirect on leave - back to local CRM
REDIRECT_ENABLED=true
REDIRECT_URL='https://app.gettwin.io.test/platform/meets'

# Sentry/Slack/Mattermost/ChatGPT/Email (disabled)
SENTRY_ENABLED=false
SLACK_ENABLED=false
MATTERMOST_ENABLED=false
CHATGPT_ENABLED=false
EMAIL_ALERT=false

# Stats (disabled)
STATS_ENABLED=false

# Webhook - local Laravel
WEBHOOK_URL=https://app.gettwin.io.test/api/webhook/mirotalk
